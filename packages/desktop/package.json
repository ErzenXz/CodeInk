{
  "name": "@codeink/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Erzen Krasniqi",
    "email": "48888391+ErzenXz@users.noreply.github.com",
    "url": "https://github.com/ErzenXz"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder --config electron-builder.config.ts",
    "package:mac": "electron-builder --mac --config electron-builder.config.ts",
    "package:win": "electron-builder --win --config electron-builder.config.ts",
    "package:linux": "electron-builder --linux --config electron-builder.config.ts",
    "native:build": "bun install --cwd native",
    "test": "bun test src/test",
    "test:installed": "bun run src/test/installed-smoke.ts",
    "test:native": "bun run src/test/native-fixture.ts",
    "predev": "bun run scripts/copy-icons.ts",
    "prebuild": "bun run scripts/copy-icons.ts && cd ../.. && bun scripts/third-party-notices.ts",
    "test:terminal": "bun build src/test/terminal-smoke.ts --target node --external @lydell/node-pty --external ws --outdir out/test && node out/test/terminal-smoke.js",
    "icons:generate": "bun run scripts/generate-icons.ts"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@zip.js/zip.js": "2.7.62",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "electron-context-menu": "4.1.2",
    "electron-log": "^5",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "electron-window-state": "^5.0.3",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@lydell/node-pty": "catalog:",
    "@codeink/app": "workspace:*",
    "@codeink/sdk": "workspace:*",
    "@codeink/ui": "workspace:*",
    "@sentry/solid": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/storage": "catalog:",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "0.15.4",
    "@types/bun": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "8.18.1",
    "@typescript/native-preview": "catalog:",
    "@valibot/to-json-schema": "1.6.0",
    "cross-spawn": "catalog:",
    "electron": "42.3.3",
    "electron-builder": "26.15.2",
    "electron-vite": "^5",
    "solid-js": "catalog:",
    "sury": "11.0.0-alpha.4",
    "typescript": "~5.6.2",
    "vite": "catalog:",
    "zod": "catalog:",
    "zod-openapi": "5.4.6"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.12",
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-arm64-musl": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-musl": "2.5.1",
    "@parcel/watcher-win32-arm64": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1"
  },
  "description": "CodeInk desktop workspace for independently installed coding agents.",
  "homepage": "https://codeink-desktop.vercel.app/",
